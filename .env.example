# Copy to .env and fill in real values before running docker compose up.

# Postgres
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow webserver admin login (created by the airflow-init service)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# On Linux, set this to your host UID (`id -u`) so mounted volumes are
# writable by the Airflow container user. Leave as-is on macOS/Windows.
AIRFLOW_UID=50000

# Free token from https://www.banxico.org.mx/SieAPIRest/service/v1/token
# If set, airflow-init seeds it as the `banxico_api_token` Airflow Variable.
BANXICO_API_TOKEN=
